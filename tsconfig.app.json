// src/ と pages/ のコードと、そこに置いたテストと story (*.server.test.ts を含む) (DOM の型)。ページは
// Worker の SSR でも動くが、DOM の型で検査する。exclude の *.server.ts(x) は tsconfig.worker.json の include と
// 揃える。ずれると、そのファイルはどの tsconfig にも入らないか、2 つに入る (ADR-0047)
{
  "extends": ["./tsconfig.base.json", "./.void/tsconfig.json", "./tsconfig.paths.json"],
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Error", "DOM", "DOM.Iterable"],
    // type reference を先に types/ で解決させる。types/ の空の @cloudflare/workers-types が、void/env などの型が
    // 足す Workers の型を空にする。依存の global の型は src/env.d.ts の triple-slash で足す (ADR-0047)
    "typeRoots": ["./types"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    ".storybook/preview.tsx"
  ],
  "exclude": ["**/*.server.ts", "**/*.server.tsx"]
}
