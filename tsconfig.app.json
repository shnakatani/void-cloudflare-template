// ブラウザで動くアプリのコード (DOM の型、Node の型なし)。ページは Worker の SSR でも動くが、DOM の型で
// 検査する。テストと story は tsconfig.test.json が持つ。exclude の並びは tsconfig.test.json の include と
// 揃える。ずれると、そのファイルはどちらの tsconfig にも入らないか、両方に入る (ADR-0047)
{
  "extends": ["./tsconfig.base.json", "./.void/tsconfig.json", "./tsconfig.paths.json"],
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Error", "DOM", "DOM.Iterable"],
    "types": ["vite-plus/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "pages/**/*.ts", "pages/**/*.tsx"],
  "exclude": [
    "pages/**/*.server.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-d.ts",
    "**/*.test-d.tsx",
    "**/*.test-helpers.ts",
    "**/*.test-helpers.tsx",
    "**/*.story-helpers.ts",
    "**/*.story-helpers.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "src/test/**"
  ]
}
