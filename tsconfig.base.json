// tsconfig.app.json・tsconfig.worker.json・tsconfig.node.json が共有する設定。実行環境で変わる lib・types・include は、
// それぞれの tsconfig が持つ (ADR-0047)
{
  "compilerOptions": {
    "target": "ES2024",
    "jsx": "react-jsx",
    "module": "ESNext",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    /* true にすると、型にだけ使う import が残り、server のモジュールが client の bundle に入る。
       false にすると外れる isolatedModules を書き足す (ADR-0068) */
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true
  }
}
