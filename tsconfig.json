// 実行環境ごとに型を分ける (ADR-0047)。ここはどのファイルも持たず、4 つの tsconfig をつなぐだけにする
{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.test.json" },
    { "path": "./tsconfig.worker.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    // shadcn の CLI はこのファイルの paths だけを読む (shadcn-ui/ui#11466)。tsconfig.app.json と同じ値にする
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
