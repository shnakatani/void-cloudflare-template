// tsconfig.app.json・tsconfig.test.json・tsconfig.worker.json が extends の最後に読む `paths`。TypeScript は
// `paths` を継承でマージせず、最後に読んだ 1 つで丸ごと置き換える。そのため `@/*` と
// `.void/tsconfig.json` の `paths` を、ここ 1 か所にまとめて持つ (ADR-0047)
{
  "compilerOptions": {
    "paths": {
      // ルートの tsconfig.json もこのファイルを extends する。shadcn の CLI はルートの tsconfig.json の paths を読む
      "@/*": ["./src/*"],
      // .void/tsconfig.json の paths の写し。パスはこのファイルからの相対で書く。
      // void/db は写さない (ADR-0047)
      "void/routes": ["./.void/routes.d.ts"],
      "@schema": ["./db/schema.ts"],
      "@schema/*": ["./db/schema/*"]
    }
  }
}
