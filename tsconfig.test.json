// テストと story (DOM の型と Node の型)。unit のテストは Node で、ブラウザテストと story は chromium で走る。
// どちらも Vitest と Storybook の型を通して Node の型を読むので、アプリのコードと分ける。
// Worker のディレクトリのテストは tsconfig.worker.json が、scripts/ と tooling/ のテストは
// tsconfig.node.json が持つ。ここに入れると、テストが読む Worker のコードが Workers の型を
// この program へ持ち込み、DOM の型とぶつかる (ADR-0047)
{
  "extends": ["./tsconfig.base.json", "./.void/tsconfig.json"],
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Error", "DOM", "DOM.Iterable"],
    // vite-plus/test/browser-playwright は、playwright の provider が vitest/browser の cdp() に足す型を読む
    "types": ["vite-plus/client", "vite-plus/test/browser-playwright", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-d.ts",
    "**/*.test-d.tsx",
    "**/*.test-helpers.ts",
    "**/*.test-helpers.tsx",
    "**/*.story-helpers.ts",
    "**/*.story-helpers.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "src/test/**/*.ts",
    "src/test/**/*.tsx",
    ".storybook/preview.tsx"
  ],
  "exclude": [
    "scripts/**",
    "tooling/**",
    "routes/**",
    "middleware/**",
    "crons/**",
    "queues/**",
    "db/**",
    "email/**",
    "durable-objects/**"
  ]
}
